    }
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build --webpack",
    "postinstall": "prisma generate",
    "start": "node scripts/run.mjs start",
    "lint": "eslint .",
